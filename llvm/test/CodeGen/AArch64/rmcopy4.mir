# RUN: llc %s -o /dev/null -swpl-debug-prepare -mcpu=a64fx -O1 -fswp -start-before=aarch64-swpipeliner 2>&1 | FileCheck %s
# CHECK: DEBUG(convertNonSSA): Suppress the generation of COPY: %25:fpr64 = PHI %0:fpr64, %bb.0, %30:fpr64, %bb.2
# CHECK-NEXT: DEBUG(convertNonSSA): change own-reg(%30) to def-reg(%25)
# CHECK-NOT: DEBUG(used_reg): own-reg(%30) is used!
# CHECK-NOT: %25:fpr64 = COPY %30:fpr64

--- |
  ; ModuleID = 'rmcopy4.cpp'
  source_filename = "rmcopy4.cpp"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
  target triple = "aarch64-unknown-linux-gnu"
  
  @a = dso_local local_unnamed_addr global [32000 x double] zeroinitializer, align 64
  @b = dso_local local_unnamed_addr global [32000 x double] zeroinitializer, align 64
  
  ; Function Attrs: mustprogress nofree norecurse nosync nounwind memory(readwrite, argmem: none, inaccessiblemem: none) uwtable vscale_range(4,4)
  define dso_local noundef double @_Z3foov() local_unnamed_addr #0 {
  entry:
    %load_initial = load double, ptr @a, align 64
    %0 = call i64 @llvm.start.loop.iterations.i64(i64 31999)
    br label %for.body
  
  for.cond.cleanup:                                 ; preds = %for.body
    %1 = load double, ptr @a, align 64, !tbaa !6
    ret double %1
  
  for.body:                                         ; preds = %entry, %for.body
    %lsr.iv12 = phi ptr [ getelementptr inbounds nuw (i8, ptr @b, i64 8), %entry ], [ %scevgep13, %for.body ]
    %lsr.iv = phi ptr [ getelementptr inbounds nuw (i8, ptr @a, i64 8), %entry ], [ %scevgep, %for.body ]
    %store_forwarded = phi double [ %load_initial, %entry ], [ %5, %for.body ]
    %2 = phi i64 [ %0, %entry ], [ %6, %for.body ]
    %3 = load double, ptr %lsr.iv12, align 8, !tbaa !6
    %4 = load double, ptr %lsr.iv, align 8, !tbaa !6
    %5 = tail call double @llvm.fmuladd.f64(double %store_forwarded, double %3, double %4)
    store double %5, ptr %lsr.iv, align 8, !tbaa !6
    %scevgep = getelementptr i8, ptr %lsr.iv, i64 8
    %scevgep13 = getelementptr i8, ptr %lsr.iv12, i64 8
    %6 = call i64 @llvm.loop.decrement.reg.i64(i64 %2, i64 1)
    %7 = icmp ne i64 %6, 0
    br i1 %7, label %for.body, label %for.cond.cleanup, !llvm.loop !10
  }
  
  ; Function Attrs: mustprogress nocallback nofree nosync nounwind speculatable willreturn memory(none)
  declare double @llvm.fmuladd.f64(double, double, double) #1
  
  ; Function Attrs: nocallback noduplicate nofree nosync nounwind willreturn
  declare i64 @llvm.start.loop.iterations.i64(i64) #2
  
  ; Function Attrs: nocallback noduplicate nofree nosync nounwind willreturn
  declare i64 @llvm.loop.decrement.reg.i64(i64, i64) #2
  
  attributes #0 = { mustprogress nofree norecurse nosync nounwind memory(readwrite, argmem: none, inaccessiblemem: none) uwtable vscale_range(4,4) "frame-pointer"="non-leaf" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="a64fx" "target-features"="+aes,+complxnum,+crc,+fp-armv8,+fullfp16,+lse,+neon,+outline-atomics,+perfmon,+ras,+rdm,+sha2,+sve,+v8.1a,+v8.2a,+v8a,-fmv" }
  attributes #1 = { mustprogress nocallback nofree nosync nounwind speculatable willreturn memory(none) }
  attributes #2 = { nocallback noduplicate nofree nosync nounwind willreturn }
  
  !llvm.module.flags = !{!0, !1, !2, !3, !4}
  !llvm.ident = !{!5}
  
  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 8, !"PIC Level", i32 2}
  !2 = !{i32 7, !"PIE Level", i32 2}
  !3 = !{i32 7, !"uwtable", i32 2}
  !4 = !{i32 7, !"frame-pointer", i32 1}
  !5 = !{!"clang version 20.1.8"}
  !6 = !{!7, !7, i64 0}
  !7 = !{!"double", !8, i64 0}
  !8 = !{!"omnipotent char", !9, i64 0}
  !9 = !{!"Simple C++ TBAA"}
  !10 = distinct !{!10, !11, !12}
  !11 = !{!"llvm.loop.mustprogress"}
  !12 = !{!"llvm.loop.unroll.disable"}

...
---
name:            _Z3foov
alignment:       8
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHCatchret:   false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: fpr64, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 2, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 3, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 4, class: fpr64, preferred-register: '', flags: [  ] }
  - { id: 5, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 6, class: fpr64, preferred-register: '', flags: [  ] }
  - { id: 7, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 8, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 9, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 10, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 11, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 12, class: gpr64common, preferred-register: '', flags: [  ] }
  - { id: 13, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 14, class: gpr64common, preferred-register: '', flags: [  ] }
  - { id: 15, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 16, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 17, class: fpr64, preferred-register: '', flags: [  ] }
  - { id: 18, class: fpr64, preferred-register: '', flags: [  ] }
  - { id: 19, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 20, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 21, class: gpr64common, preferred-register: '', flags: [  ] }
  - { id: 22, class: fpr64, preferred-register: '', flags: [  ] }
liveins:         []
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
  savePoint:       ''
  restorePoint:    ''
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    successors: %bb.2(0x80000000)
  
    %12:gpr64common = MOVaddr target-flags(aarch64-page) @a, target-flags(aarch64-pageoff, aarch64-nc) @a
    early-clobber %13:gpr64sp, %0:fpr64 = LDRDpost %12, 8 :: (load (s64) from @a, align 64)
    %14:gpr64common = MOVaddr target-flags(aarch64-page) @b + 8, target-flags(aarch64-pageoff, aarch64-nc) @b + 8
    %10:gpr64all = COPY %14
    %11:gpr64all = COPY %13
    %15:gpr32 = MOVi32imm 31999
    %1:gpr64all = SUBREG_TO_REG 0, killed %15, %subreg.sub_32
    B %bb.2
  
  bb.1.for.cond.cleanup:
    %21:gpr64common = ADRP target-flags(aarch64-page) @a
    %22:fpr64 = LDRDui killed %21, target-flags(aarch64-pageoff, aarch64-nc) @a :: (dereferenceable load (s64) from @a, align 64, !tbaa !6)
    $d0 = COPY %22
    RET_ReallyLR implicit $d0
  
  bb.2.for.body:
    successors: %bb.2(0x7c000000), %bb.1(0x04000000)
  
    %2:gpr64sp = PHI %10, %bb.0, %8, %bb.2
    %3:gpr64sp = PHI %11, %bb.0, %7, %bb.2
    %4:fpr64 = PHI %0, %bb.0, %6, %bb.2
    %5:gpr64sp = PHI %1, %bb.0, %9, %bb.2
    early-clobber %16:gpr64sp, %17:fpr64 = LDRDpost %2, 8 :: (load (s64) from %ir.lsr.iv12, !tbaa !6)
    %18:fpr64 = LDRDui %3, 0 :: (load (s64) from %ir.lsr.iv, !tbaa !6)
    %6:fpr64 = nofpexcept FMADDDrrr %4, killed %17, killed %18, implicit $fpcr
    early-clobber %19:gpr64sp = STRDpost %6, %3, 8 :: (store (s64) into %ir.lsr.iv, !tbaa !6)
    %7:gpr64all = COPY %19
    %8:gpr64all = COPY %16
    %20:gpr64 = SUBSXri %5, 1, 0, implicit-def $nzcv
    %9:gpr64all = COPY %20
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.1

...
