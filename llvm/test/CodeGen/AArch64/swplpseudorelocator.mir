# RUN: llc %s -start-after=machine-scheduler -stop-before=machine-block-freq -print-after=swpl-relocator -o /dev/null 2>&1 | FileCheck %s
#CHECK:1288B     SWPLIVEIN
#CHECK-NEXT:1328B     $xzr = SUBSXri %78:gpr64common, 0, 0, implicit-def $nzcv
#CHECK-NEXT:1336B     SWPLIVEOUT
#CHECK:1352B     SWPLIVEIN
#CHECK-NEXT:1360B     early-clobber %9:gpr64common, %17:gpr32 = LDRWpost %9:gpr64common(tied-def 0), 4 :: (volatile load (s32) from %ir.10, !tbaa !6)
#CHECK-NEXT:1376B     %82:gpr32 = nsw ADDWrr %17:gpr32, %82:gpr32
#CHECK-NEXT:1408B     %78:gpr64common = SUBSXri %78:gpr64common, 1, 0, implicit-def $nzcv
#CHECK-NEXT:1416B     SWPLIVEOUT
--- |
  ; ModuleID = 'a.c'
  source_filename = "a.c"
  target datalayout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
  target triple = "aarch64-unknown-linux-gnu"
  
  ; Function Attrs: nofree norecurse nosync nounwind memory(argmem: read) uwtable vscale_range(1,16)
  define dso_local i32 @sub(i32 noundef %0, ptr nocapture noundef readonly %1) local_unnamed_addr #0 {
    %3 = icmp sgt i32 %0, 0
    br i1 %3, label %4, label %7
  
  4:                                                ; preds = %2
    %5 = zext nneg i32 %0 to i64
    %6 = call i64 @llvm.start.loop.iterations.i64(i64 %5)
    br label %9
  
  7:                                                ; preds = %9, %2
    %8 = phi i32 [ 0, %2 ], [ %14, %9 ]
    ret i32 %8
  
  9:                                                ; preds = %4, %9
    %10 = phi ptr [ %1, %4 ], [ %15, %9 ]
    %11 = phi i32 [ 0, %4 ], [ %14, %9 ]
    %12 = phi i64 [ %6, %4 ], [ %16, %9 ]
    %13 = load i32, ptr %10, align 4, !tbaa !6
    %14 = add nsw i32 %13, %11
    %15 = getelementptr i8, ptr %10, i64 4
    %16 = call i64 @llvm.loop.decrement.reg.i64(i64 %12, i64 1)
    %17 = icmp ne i64 %16, 0
    br i1 %17, label %9, label %7, !llvm.loop !10
  }
  
  ; Function Attrs: nocallback noduplicate nofree nosync nounwind willreturn
  declare i64 @llvm.start.loop.iterations.i64(i64) #1
  
  ; Function Attrs: nocallback noduplicate nofree nosync nounwind willreturn
  declare i64 @llvm.loop.decrement.reg.i64(i64, i64) #1
  
  attributes #0 = { nofree norecurse nosync nounwind memory(argmem: read) uwtable vscale_range(1,16) "frame-pointer"="non-leaf" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="a64fx" "target-features"="+aes,+crc,+fp-armv8,+fullfp16,+lse,+neon,+outline-atomics,+ras,+rdm,+sha2,+sve,+v8.1a,+v8.2a,+v8a,-fmv" }
  attributes #1 = { nocallback noduplicate nofree nosync nounwind willreturn }
  
  !llvm.module.flags = !{!0, !1, !2, !3, !4}
  !llvm.ident = !{!5}
  
  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 8, !"PIC Level", i32 2}
  !2 = !{i32 7, !"PIE Level", i32 2}
  !3 = !{i32 7, !"uwtable", i32 2}
  !4 = !{i32 7, !"frame-pointer", i32 1}
  !5 = !{!"clang version 18.1.8 (git@172.16.1.70:a64fx-swpl/llvm-project.git 57e66426e947e5e21c0d93843444e58104b5c305)"}
  !6 = !{!7, !7, i64 0}
  !7 = !{!"int", !8, i64 0}
  !8 = !{!"omnipotent char", !9, i64 0}
  !9 = !{!"Simple C/C++ TBAA"}
  !10 = distinct !{!10, !11, !12}
  !11 = !{!"llvm.loop.mustprogress"}
  !12 = !{!"llvm.loop.unroll.disable"}

...
---
name:            sub
alignment:       8
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
callsEHReturn:   false
callsUnwindInit: false
hasEHCatchret:   false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gpr64, preferred-register: '' }
  - { id: 1, class: gpr32all, preferred-register: '' }
  - { id: 2, class: gpr64sp, preferred-register: '' }
  - { id: 3, class: gpr32, preferred-register: '' }
  - { id: 4, class: gpr64sp, preferred-register: '' }
  - { id: 5, class: gpr32, preferred-register: '' }
  - { id: 6, class: gpr64all, preferred-register: '' }
  - { id: 7, class: gpr64, preferred-register: '' }
  - { id: 8, class: gpr32common, preferred-register: '' }
  - { id: 9, class: gpr64common, preferred-register: '' }
  - { id: 10, class: gpr32all, preferred-register: '' }
  - { id: 11, class: gpr32all, preferred-register: '' }
  - { id: 12, class: gpr32, preferred-register: '' }
  - { id: 13, class: gpr32all, preferred-register: '' }
  - { id: 14, class: gpr32, preferred-register: '' }
  - { id: 15, class: gpr32all, preferred-register: '' }
  - { id: 16, class: gpr64sp, preferred-register: '' }
  - { id: 17, class: gpr32, preferred-register: '' }
  - { id: 18, class: gpr32, preferred-register: '' }
  - { id: 19, class: gpr64, preferred-register: '' }
  - { id: 20, class: gpr64sp, preferred-register: '' }
  - { id: 21, class: gpr32, preferred-register: '' }
  - { id: 22, class: gpr64sp, preferred-register: '' }
  - { id: 23, class: gpr64sp, preferred-register: '' }
  - { id: 24, class: gpr32, preferred-register: '' }
  - { id: 25, class: gpr32, preferred-register: '' }
  - { id: 26, class: gpr32all, preferred-register: '' }
  - { id: 27, class: gpr64all, preferred-register: '' }
  - { id: 28, class: gpr64, preferred-register: '' }
  - { id: 29, class: gpr64all, preferred-register: '' }
  - { id: 30, class: gpr32, preferred-register: '' }
  - { id: 31, class: gpr32, preferred-register: '' }
  - { id: 32, class: gpr64sp, preferred-register: '' }
  - { id: 33, class: gpr64sp, preferred-register: '' }
  - { id: 34, class: gpr64sp, preferred-register: '' }
  - { id: 35, class: gpr64sp, preferred-register: '' }
  - { id: 36, class: gpr32, preferred-register: '' }
  - { id: 37, class: gpr32, preferred-register: '' }
  - { id: 38, class: gpr32, preferred-register: '' }
  - { id: 39, class: gpr32, preferred-register: '' }
  - { id: 40, class: gpr32all, preferred-register: '' }
  - { id: 41, class: gpr32all, preferred-register: '' }
  - { id: 42, class: gpr64, preferred-register: '' }
  - { id: 43, class: gpr64, preferred-register: '' }
  - { id: 44, class: gpr64sp, preferred-register: '' }
  - { id: 45, class: gpr64sp, preferred-register: '' }
  - { id: 46, class: gpr64sp, preferred-register: '' }
  - { id: 47, class: gpr64sp, preferred-register: '' }
  - { id: 48, class: gpr32, preferred-register: '' }
  - { id: 49, class: gpr64sp, preferred-register: '' }
  - { id: 50, class: gpr32all, preferred-register: '' }
  - { id: 51, class: gpr32, preferred-register: '' }
  - { id: 52, class: gpr64sp, preferred-register: '' }
  - { id: 53, class: gpr64, preferred-register: '' }
  - { id: 54, class: gpr32, preferred-register: '' }
  - { id: 55, class: gpr32, preferred-register: '' }
  - { id: 56, class: gpr32, preferred-register: '' }
  - { id: 57, class: gpr64sp, preferred-register: '' }
  - { id: 58, class: gpr32, preferred-register: '' }
  - { id: 59, class: gpr64common, preferred-register: '' }
  - { id: 60, class: gpr32, preferred-register: '' }
  - { id: 61, class: gpr64, preferred-register: '' }
  - { id: 62, class: gpr32all, preferred-register: '' }
  - { id: 63, class: gpr32, preferred-register: '' }
  - { id: 64, class: gpr64common, preferred-register: '' }
  - { id: 65, class: gpr32, preferred-register: '' }
  - { id: 66, class: gpr64, preferred-register: '' }
  - { id: 67, class: gpr32all, preferred-register: '' }
  - { id: 68, class: gpr32, preferred-register: '' }
  - { id: 69, class: gpr64sp, preferred-register: '' }
  - { id: 70, class: gpr32all, preferred-register: '' }
  - { id: 71, class: gpr32all, preferred-register: '' }
  - { id: 72, class: gpr32all, preferred-register: '' }
  - { id: 73, class: gpr32all, preferred-register: '' }
  - { id: 74, class: gpr64sp, preferred-register: '' }
  - { id: 75, class: gpr32all, preferred-register: '' }
  - { id: 76, class: gpr64sp, preferred-register: '' }
  - { id: 77, class: gpr32, preferred-register: '' }
  - { id: 78, class: gpr64common, preferred-register: '' }
  - { id: 79, class: gpr64sp, preferred-register: '' }
  - { id: 80, class: gpr32, preferred-register: '' }
  - { id: 81, class: gpr64common, preferred-register: '' }
  - { id: 82, class: gpr32, preferred-register: '' }
liveins:
  - { reg: '$w0', virtual-reg: '%8' }
  - { reg: '$x1', virtual-reg: '%9' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  localFrameSize:  0
  savePoint:       ''
  restorePoint:    ''
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0 (%ir-block.2):
    successors: %bb.2(0x50000000), %bb.1(0x30000000)
    liveins: $w0, $x1
  
    %9:gpr64common = COPY $x1
    %8:gpr32common = COPY $w0
    dead $wzr = SUBSWri %8, 1, 0, implicit-def $nzcv
    Bcc 10, %bb.2, implicit killed $nzcv
  
  bb.1:
    successors: %bb.3(0x80000000)
  
    %82:gpr32 = COPY $wzr
    B %bb.3
  
  bb.2 (%ir-block.4):
    successors: %bb.4(0x80000000)
  
    undef %78.sub_32:gpr64common = ORRWrs $wzr, %8, 0
    %82:gpr32 = COPY $wzr
    B %bb.4
  
  bb.3 (%ir-block.7):
    $w0 = COPY %82
    RET_ReallyLR implicit $w0
  
  bb.4 (%ir-block.9):
    successors: %bb.5(0x40000000), %bb.12(0x40000000)
  
    $xzr = SUBSXri %78, 6, 0, implicit-def $nzcv
    Bcc 10, %bb.5, implicit killed $nzcv
  
  bb.12:
    successors: %bb.9(0x80000000)
  
    B %bb.9
  
  bb.5 (%ir-block.9):
    successors: %bb.6(0x80000000)
  
    %30:gpr32 = LDURWi %9, 0 :: (volatile load (s32) from %ir.10, !tbaa !6)
    %32:gpr64sp = ADDXri %9, 4, 0
    %31:gpr32 = LDURWi %32, 0 :: (volatile load (s32) from %ir.10, !tbaa !6)
    %33:gpr64sp = ADDXri %32, 4, 0
    %24:gpr32 = LDURWi %33, 0 :: (volatile load (s32) from %ir.10, !tbaa !6)
    %74:gpr64sp = ADDXri %33, 4, 0
    %36:gpr32 = nsw ADDWrr %30, %82
    %42:gpr64 = SUBSXri %78, 1, 0, implicit-def dead $nzcv
    $w1 = COPY %36
    $x3 = COPY %74
    $x4 = COPY %42
    $w5 = COPY %31
    $w7 = COPY %24
    SWPLIVEOUT implicit $w1, implicit killed $x3, implicit killed $x4, implicit killed $w5, implicit killed $w7
  
  bb.6 (%ir-block.9):
    successors: %bb.6(0x7c000000), %bb.7(0x04000000)
  
    SWPLIVEIN implicit-def $w1, implicit-def $x3, implicit-def $x4, implicit-def $w5, implicit-def $w7
    $w0 = COPY $w1
    $w2 = LDURWi $x3, 0 :: (volatile load (s32) from %ir.10, !tbaa !6)
    $x1 = ADDXri killed $x3, 4, 0
    $x3 = COPY killed $x4
    $w4 = nsw ADDWrr killed $w5, $w0
    $x6 = SUBSXri killed $x3, 1, 0, implicit-def dead $nzcv
    $x3 = COPY $x1
    dead %71:gpr32all = COPY $w0
    $w0 = COPY killed $w4
    $w5 = LDURWi $x3, 0 :: (volatile load (s32) from %ir.10, !tbaa !6)
    $x1 = ADDXri killed $x3, 4, 0
    $x3 = COPY killed $x6
    $w4 = nsw ADDWrr killed $w7, $w0
    $x6 = SUBSXri killed $x3, 1, 0, implicit-def dead $nzcv
    $x3 = COPY $x1
    dead %72:gpr32all = COPY $w0
    $w0 = COPY killed $w4
    $w7 = LDURWi $x3, 0 :: (volatile load (s32) from %ir.10, !tbaa !6)
    $x8 = ADDXri killed $x3, 4, 0
    $x3 = COPY killed $x6
    $w1 = nsw ADDWrr killed $w2, $w0
    $x4 = SUBSXri killed $x3, 1, 0, implicit-def dead $nzcv
    $x3 = COPY killed $x8
    dead %73:gpr32all = COPY $w0
    SWPLIVEOUT implicit $w1, implicit killed $x3, implicit $x4, implicit killed $w5, implicit killed $w7, implicit $w0
    $xzr = SUBSXri killed $x4, 5, 0, implicit-def $nzcv
    Bcc 10, %bb.6, implicit killed $nzcv
  
  bb.7 (%ir-block.9):
    successors: %bb.8(0x80000000)
  
    SWPLIVEIN implicit-def $w1, implicit-def $x3, implicit-def $x4, implicit-def $w5, implicit-def $w7, implicit-def $w0, implicit-def $x3
    %58:gpr32 = COPY $w1
    %9:gpr64common = COPY $x3
    %59:gpr64common = COPY killed $x4
    %54:gpr32 = COPY killed $w5
    %55:gpr32 = COPY killed $w7
    dead %56:gpr32 = COPY $w0
    dead %57:gpr64sp = COPY killed $x3
    %63:gpr32 = nsw ADDWrr %54, %58
    %64:gpr64common = SUBSXri %59, 1, 0, implicit-def dead $nzcv
    %82:gpr32 = nsw ADDWrr %55, %63
    %78:gpr64common = SUBSXri %64, 1, 0, implicit-def dead $nzcv
  
  bb.8 (%ir-block.9):
    successors: %bb.9(0x40000000), %bb.11(0x40000000)
  
    $xzr = SUBSXri %78, 0, 0, implicit-def $nzcv
    Bcc 0, %bb.11, implicit killed $nzcv
  
  bb.9 (%ir-block.9):
    successors: %bb.10(0x80000000)
    SWPLIVEIN
    SWPLIVEOUT
    $xzr = SUBSXri %78, 0, 0, implicit-def $nzcv
  
  
  bb.10 (%ir-block.9):
    successors: %bb.10(0x40000000), %bb.11(0x40000000)
  
    early-clobber %9:gpr64common, %17:gpr32 = LDRWpost %9, 4 :: (volatile load (s32) from %ir.10, !tbaa !6)
    %82:gpr32 = nsw ADDWrr %17, %82
    SWPLIVEIN
    %78:gpr64common = SUBSXri %78, 1, 0, implicit-def $nzcv
    SWPLIVEOUT
    Bcc 1, %bb.10, implicit killed $nzcv
    B %bb.11
  
  bb.11 (%ir-block.9):
    successors: %bb.3(0x80000000)
  
    B %bb.3

...
