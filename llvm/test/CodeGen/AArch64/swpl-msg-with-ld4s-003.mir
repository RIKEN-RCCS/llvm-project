# RUN: llc -O3 -mcpu=a64fx -pass-remarks=aarch64-swpipeliner -pass-remarks-missed=aarch64-swpipeliner -pass-remarks-analysis=aarch64-swpipeliner -fswp -swpl-maxii=3 -start-before=aarch64-swpipeliner -o /dev/null %s 2>&1 |& FileCheck %s
# CHECK: remark: sample.c:8:3: SVE instruction latency is calculated at 512bit.
# CHECK: remark: sample.c:8:3: distributed loop: 3 of 3 Since the calculated min_ii(3) is greater than or equal to max_ii(3), processing continues with max_ii=min_ii+1.
# CHECK: remark: sample.c:8:3: distributed loop: 3 of 3 The number of COPY instructions in the kernel loop for software pipelining is 12.
# CHECK: remark: sample.c:8:3: distributed loop: 3 of 3 software pipelining
# CHECK: remark: sample.c:8:3: distributed loop: 1 of 3 Since the calculated min_ii(3) is greater than or equal to max_ii(3), processing continues with max_ii=min_ii+1.
# CHECK: remark: sample.c:8:3: distributed loop: 1 of 3 Trial at iteration-interval=3. This loop is not software pipelined because no schedule is obtained.
# CHECK: remark: sample.c:8:3: distributed loop: 2 of 3 Since the calculated min_ii(3) is greater than or equal to max_ii(3), processing continues with max_ii=min_ii+1.
# CHECK: remark: sample.c:8:3: distributed loop: 2 of 3 Trial at iteration-interval=3. This loop is not software pipelined because no schedule is obtained.

--- |
  ; ModuleID = './swpl-msg-with-ld4s-003.ll'
  source_filename = "./sample.c"
  target datalayout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
  target triple = "aarch64-unknown-linux-gnu"
  
  ; Function Attrs: nofree norecurse nosync nounwind memory(argmem: readwrite) uwtable vscale_range(4,4)
  define dso_local float @foo(i32 noundef %n, ptr nocapture noundef %A, ptr nocapture noundef readonly %B, ptr nocapture noundef writeonly %C, ptr nocapture noundef readonly %D, ptr nocapture noundef readonly %E, ptr nocapture noundef readonly %C1, ptr nocapture noundef readonly %D1, ptr nocapture noundef readnone %E1) local_unnamed_addr #0 !dbg !9 {
  entry:
    %cmp30 = icmp sgt i32 %n, 0, !dbg !13
    br i1 %cmp30, label %for.body.preheader, label %for.end, !dbg !14
  
  for.body.preheader:                               ; preds = %entry
    %0 = zext nneg i32 %n to i64, !dbg !14
    %load_initial = load float, ptr %A, align 4
    %scevgep11 = getelementptr i8, ptr %A, i64 4, !dbg !14
    %1 = call i64 @llvm.start.loop.iterations.i64(i64 %0), !dbg !14
    br label %for.body.ldist1, !dbg !14
  
  for.body.ldist1:                                  ; preds = %for.body.ldist1, %for.body.preheader
    %lsr.iv16 = phi ptr [ %scevgep17, %for.body.ldist1 ], [ %B, %for.body.preheader ]
    %lsr.iv14 = phi ptr [ %scevgep15, %for.body.ldist1 ], [ %C1, %for.body.preheader ]
    %lsr.iv12 = phi ptr [ %scevgep13, %for.body.ldist1 ], [ %scevgep11, %for.body.preheader ]
    %store_forwarded = phi float [ %load_initial, %for.body.preheader ], [ %5, %for.body.ldist1 ]
    %2 = phi i64 [ %1, %for.body.preheader ], [ %6, %for.body.ldist1 ], !dbg !15
    %3 = load float, ptr %lsr.iv16, align 4, !dbg !15, !tbaa !16
    %4 = load float, ptr %lsr.iv14, align 4, !dbg !20, !tbaa !16
    %5 = tail call float @llvm.fmuladd.f32(float %store_forwarded, float %3, float %4), !dbg !21
    store float %5, ptr %lsr.iv12, align 4, !dbg !22, !tbaa !16
    %scevgep13 = getelementptr i8, ptr %lsr.iv12, i64 4, !dbg !13
    %scevgep15 = getelementptr i8, ptr %lsr.iv14, i64 4, !dbg !13
    %scevgep17 = getelementptr i8, ptr %lsr.iv16, i64 4, !dbg !13
    %6 = call i64 @llvm.loop.decrement.reg.i64(i64 %2, i64 1), !dbg !14
    %7 = icmp ne i64 %6, 0, !dbg !14
    br i1 %7, label %for.body.ldist1, label %for.body.ldist2.preheader, !dbg !14, !llvm.loop !23
  
  for.body.ldist2.preheader:                        ; preds = %for.body.ldist1
    %8 = call i64 @llvm.start.loop.iterations.i64(i64 %0), !dbg !14
    br label %for.body.ldist2, !dbg !14
  
  for.body.ldist2:                                  ; preds = %for.body.ldist2.preheader, %for.body.ldist2
    %lsr.iv6 = phi ptr [ %D, %for.body.ldist2.preheader ], [ %scevgep7, %for.body.ldist2 ]
    %lsr.iv4 = phi ptr [ %E, %for.body.ldist2.preheader ], [ %scevgep5, %for.body.ldist2 ]
    %lsr.iv2 = phi ptr [ %D1, %for.body.ldist2.preheader ], [ %scevgep3, %for.body.ldist2 ]
    %lsr.iv = phi ptr [ %C, %for.body.ldist2.preheader ], [ %scevgep, %for.body.ldist2 ]
    %9 = phi i64 [ %8, %for.body.ldist2.preheader ], [ %14, %for.body.ldist2 ], !dbg !28
    %10 = load float, ptr %lsr.iv6, align 4, !dbg !28, !tbaa !16
    %11 = load float, ptr %lsr.iv4, align 4, !dbg !29, !tbaa !16
    %12 = load float, ptr %lsr.iv2, align 4, !dbg !30, !tbaa !16
    %13 = tail call float @llvm.fmuladd.f32(float %10, float %11, float %12), !dbg !31
    store float %13, ptr %lsr.iv, align 4, !dbg !32, !tbaa !16
    %scevgep = getelementptr i8, ptr %lsr.iv, i64 4, !dbg !13
    %scevgep3 = getelementptr i8, ptr %lsr.iv2, i64 4, !dbg !13
    %scevgep5 = getelementptr i8, ptr %lsr.iv4, i64 4, !dbg !13
    %scevgep7 = getelementptr i8, ptr %lsr.iv6, i64 4, !dbg !13
    %14 = call i64 @llvm.loop.decrement.reg.i64(i64 %9, i64 1), !dbg !14
    %15 = icmp ne i64 %14, 0, !dbg !14
    br i1 %15, label %for.body.ldist2, label %for.body.preheader1, !dbg !14, !llvm.loop !33
  
  for.body.preheader1:                              ; preds = %for.body.ldist2
    %16 = call i64 @llvm.start.loop.iterations.i64(i64 %0), !dbg !14
    br label %for.body, !dbg !14
  
  for.body:                                         ; preds = %for.body.preheader1, %for.body
    %indvars.iv = phi i64 [ %indvars.iv.next, %for.body ], [ 0, %for.body.preheader1 ]
    %z.032 = phi float [ %add8, %for.body ], [ 0.000000e+00, %for.body.preheader1 ]
    %17 = phi i64 [ %16, %for.body.preheader1 ], [ %19, %for.body ], !dbg !35
    %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1, !dbg !35
    %18 = add i64 %0, %indvars.iv, !dbg !36
    %tmp = trunc i64 %18 to i32
    %conv = sitofp i32 %tmp to float, !dbg !36
    %add8 = fadd float %z.032, %conv, !dbg !37
    %19 = call i64 @llvm.loop.decrement.reg.i64(i64 %17, i64 1), !dbg !14
    %20 = icmp ne i64 %19, 0, !dbg !14
    br i1 %20, label %for.body, label %for.end, !dbg !14, !llvm.loop !38
  
  for.end:                                          ; preds = %for.body, %entry
    %z.0.lcssa = phi float [ 0.000000e+00, %entry ], [ %add8, %for.body ], !dbg !40
    ret float %z.0.lcssa, !dbg !41
  }
  
  ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
  declare float @llvm.fmuladd.f32(float, float, float) #1
  
  ; Function Attrs: nocallback noduplicate nofree nosync nounwind willreturn
  declare i64 @llvm.start.loop.iterations.i64(i64) #2
  
  ; Function Attrs: nocallback noduplicate nofree nosync nounwind willreturn
  declare i64 @llvm.loop.decrement.reg.i64(i64, i64) #2
  
  attributes #0 = { nofree norecurse nosync nounwind memory(argmem: readwrite) uwtable vscale_range(4,4) "frame-pointer"="non-leaf" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="a64fx" "target-features"="+aes,+crc,+fp-armv8,+fullfp16,+lse,+neon,+outline-atomics,+ras,+rdm,+sha2,+sve,+v8.1a,+v8.2a,+v8a,-fmv" }
  attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) "target-cpu"="a64fx" }
  attributes #2 = { nocallback noduplicate nofree nosync nounwind willreturn }
  
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3, !4, !5, !6, !7}
  !llvm.ident = !{!8}
  
  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, producer: "clang version 18.1.8", isOptimized: true, runtimeVersion: 0, emissionKind: NoDebug, splitDebugInlining: false, nameTableKind: None)
  !1 = !DIFile(filename: "./sample.c", directory: ".")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = !{i32 1, !"wchar_size", i32 4}
  !4 = !{i32 8, !"PIC Level", i32 2}
  !5 = !{i32 7, !"PIE Level", i32 2}
  !6 = !{i32 7, !"uwtable", i32 2}
  !7 = !{i32 7, !"frame-pointer", i32 1}
  !8 = !{!"clang version 18.1.8"}
  !9 = distinct !DISubprogram(name: "foo", scope: !10, file: !10, line: 2, type: !11, scopeLine: 5, flags: DIFlagPrototyped, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !10 = !DIFile(filename: "sample.c", directory: ".")
  !11 = !DISubroutineType(types: !12)
  !12 = !{}
  !13 = !DILocation(line: 8, column: 17, scope: !9)
  !14 = !DILocation(line: 8, column: 3, scope: !9)
  !15 = !DILocation(line: 9, column: 23, scope: !9)
  !16 = !{!17, !17, i64 0}
  !17 = !{!"float", !18, i64 0}
  !18 = !{!"omnipotent char", !19, i64 0}
  !19 = !{!"Simple C/C++ TBAA"}
  !20 = !DILocation(line: 9, column: 30, scope: !9)
  !21 = !DILocation(line: 9, column: 28, scope: !9)
  !22 = !DILocation(line: 9, column: 14, scope: !9)
  !23 = distinct !{!23, !14, !24, !25, !26, !27}
  !24 = !DILocation(line: 13, column: 3, scope: !9)
  !25 = !{!"llvm.loop.mustprogress"}
  !26 = !{!"llvm.loop.unroll.disable"}
  !27 = !{!"llvm.loop.distributed4swpl", i32 3, i32 2}
  !28 = !DILocation(line: 11, column: 12, scope: !9)
  !29 = !DILocation(line: 11, column: 19, scope: !9)
  !30 = !DILocation(line: 11, column: 26, scope: !9)
  !31 = !DILocation(line: 11, column: 24, scope: !9)
  !32 = !DILocation(line: 11, column: 10, scope: !9)
  !33 = distinct !{!33, !14, !24, !25, !26, !34}
  !34 = !{!"llvm.loop.distributed4swpl", i32 3, i32 1}
  !35 = !DILocation(line: 9, column: 9, scope: !9)
  !36 = !DILocation(line: 10, column: 10, scope: !9)
  !37 = !DILocation(line: 10, column: 7, scope: !9)
  !38 = distinct !{!38, !14, !24, !25, !26, !39}
  !39 = !{!"llvm.loop.distributed4swpl", i32 3, i32 3}
  !40 = !DILocation(line: 0, scope: !9)
  !41 = !DILocation(line: 14, column: 3, scope: !9)

...
---
name:            foo
alignment:       8
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
callsEHReturn:   false
callsUnwindInit: false
hasEHCatchret:   false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gpr64all, preferred-register: '' }
  - { id: 1, class: fpr32, preferred-register: '' }
  - { id: 2, class: gpr64all, preferred-register: '' }
  - { id: 3, class: gpr64all, preferred-register: '' }
  - { id: 4, class: gpr64sp, preferred-register: '' }
  - { id: 5, class: gpr64sp, preferred-register: '' }
  - { id: 6, class: gpr64sp, preferred-register: '' }
  - { id: 7, class: fpr32, preferred-register: '' }
  - { id: 8, class: gpr64sp, preferred-register: '' }
  - { id: 9, class: fpr32, preferred-register: '' }
