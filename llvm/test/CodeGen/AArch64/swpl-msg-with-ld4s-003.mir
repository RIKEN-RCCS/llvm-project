      isImmutable: true, isAliased: false, callee-saved-register: '', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    successors: %bb.1(0x50000000), %bb.8(0x30000000)
    liveins: $w0, $x1, $x2, $x3, $x4, $x5, $x6, $x7
  
    %40:gpr64 = COPY $x7
    %39:gpr64 = COPY $x6
    %38:gpr64 = COPY $x5
    %37:gpr64 = COPY $x4
    %36:gpr64 = COPY $x3
    %35:gpr64 = COPY $x2
    %34:gpr64common = COPY $x1
    %33:gpr32common = COPY $w0
    dead $wzr = SUBSWri %33, 1, 0, implicit-def $nzcv, debug-location !14
    Bcc 10, %bb.1, implicit $nzcv, debug-location !14
  
  bb.8:
    successors: %bb.7(0x80000000)
  
    %41:fpr32 = FMOVS0
    B %bb.7
  
  bb.1.for.body.preheader:
    successors: %bb.2(0x80000000)
  
    %43:gpr32 = ORRWrs $wzr, %33, 0, debug-location !14
    %3:gpr64all = SUBREG_TO_REG 0, killed %43, %subreg.sub_32, debug-location !14
    %0:gpr64all = COPY %3, debug-location !14
    early-clobber %44:gpr64sp, %1:fpr32 = LDRSpost %34, 4 :: (load (s32) from %ir.A)
    %2:gpr64all = COPY %44, debug-location !14
  
  bb.2.for.body.ldist1:
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  
    %4:gpr64sp = PHI %35, %bb.1, %12, %bb.2
    %5:gpr64sp = PHI %39, %bb.1, %11, %bb.2
    %6:gpr64sp = PHI %2, %bb.1, %10, %bb.2
    %7:fpr32 = PHI %1, %bb.1, %9, %bb.2
    %8:gpr64sp = PHI %3, %bb.1, %13, %bb.2, debug-location !15
    early-clobber %45:gpr64sp, %46:fpr32 = LDRSpost %4, 4, debug-location !15 :: (load (s32) from %ir.lsr.iv16, !tbaa !16)
    early-clobber %47:gpr64sp, %48:fpr32 = LDRSpost %5, 4, debug-location !20 :: (load (s32) from %ir.lsr.iv14, !tbaa !16)
    %9:fpr32 = nofpexcept FMADDSrrr %7, killed %46, killed %48, implicit $fpcr, debug-location !21
    early-clobber %49:gpr64sp = STRSpost %9, %6, 4, debug-location !22 :: (store (s32) into %ir.lsr.iv12, !tbaa !16)
    %10:gpr64all = COPY %49, debug-location !13
    %11:gpr64all = COPY %47, debug-location !13
    %12:gpr64all = COPY %45, debug-location !13
    %50:gpr64 = SUBSXri %8, 1, 0, implicit-def $nzcv, debug-location !14
    %13:gpr64all = COPY %50, debug-location !14
    Bcc 1, %bb.2, implicit $nzcv, debug-location !14
    B %bb.3, debug-location !14
  
  bb.3.for.body.ldist2.preheader:
    successors: %bb.4(0x80000000)
  
    %14:gpr64all = COPY %0, debug-location !14
  
  bb.4.for.body.ldist2:
    successors: %bb.4(0x7c000000), %bb.5(0x04000000)
  
    %15:gpr64sp = PHI %37, %bb.3, %23, %bb.4
    %16:gpr64sp = PHI %38, %bb.3, %22, %bb.4
    %17:gpr64sp = PHI %40, %bb.3, %21, %bb.4
    %18:gpr64sp = PHI %36, %bb.3, %20, %bb.4
    %19:gpr64sp = PHI %14, %bb.3, %24, %bb.4, debug-location !28
    early-clobber %51:gpr64sp, %52:fpr32 = LDRSpost %15, 4, debug-location !28 :: (load (s32) from %ir.lsr.iv6, !tbaa !16)
    early-clobber %53:gpr64sp, %54:fpr32 = LDRSpost %16, 4, debug-location !29 :: (load (s32) from %ir.lsr.iv4, !tbaa !16)
    early-clobber %55:gpr64sp, %56:fpr32 = LDRSpost %17, 4, debug-location !30 :: (load (s32) from %ir.lsr.iv2, !tbaa !16)
    %57:fpr32 = nofpexcept FMADDSrrr killed %52, killed %54, killed %56, implicit $fpcr, debug-location !31
    early-clobber %58:gpr64sp = STRSpost killed %57, %18, 4, debug-location !32 :: (store (s32) into %ir.lsr.iv, !tbaa !16)
    %20:gpr64all = COPY %58, debug-location !13
    %21:gpr64all = COPY %55, debug-location !13
    %22:gpr64all = COPY %53, debug-location !13
    %23:gpr64all = COPY %51, debug-location !13
    %59:gpr64 = SUBSXri %19, 1, 0, implicit-def $nzcv, debug-location !14
    %24:gpr64all = COPY %59, debug-location !14
    Bcc 1, %bb.4, implicit $nzcv, debug-location !14
    B %bb.5, debug-location !14
  
  bb.5.for.body.preheader1:
    successors: %bb.6(0x80000000)
  
    %61:fpr32 = FMOVS0
    %62:gpr64all = COPY $xzr
    %60:gpr64all = COPY %62
    %25:gpr64all = COPY %0, debug-location !14
    %65:gpr32 = COPY %0.sub_32
  
  bb.6.for.body:
    successors: %bb.6(0x7c000000), %bb.7(0x04000000)
  
