# RUN: llc -mcpu=a64fx -march=aarch64 -fswp -swpl-debug -start-before=aarch64-swpipeliner -stop-after=aarch64-swpipeliner -pass-remarks-missed=aarch64-swpipeliner -o /dev/null  %s 2>&1 | FileCheck %s
#CHECK:pipeliner info:found non-target-inst or gnuasm
#CHECK: This loop cannot be software pipelined because the loop contains an instruction, such as function call, which is not supported.

--- |
  ; ModuleID = './swpl-canpipelineloop-044.c'
  source_filename = "./swpl-canpipelineloop-044.c"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
  target triple = "aarch64-unknown-linux-gnu"
  
  @a = external local_unnamed_addr global [32000 x double], align 64
  
  ; Function Attrs: nofree norecurse nosync nounwind memory(read, argmem: none, inaccessiblemem: none) uwtable vscale_range(4,4)
  define dso_local nofpclass(nan inf) double @target() local_unnamed_addr #0 {
  entry:
    br label %vector.ph
  
  vector.ph:                                        ; preds = %middle.block, %entry
    %nl.017 = phi i32 [ 0, %entry ], [ %inc7, %middle.block ]
    %0 = call i64 @llvm.start.loop.iterations.i64(i64 8000)
    br label %vector.body
  
  vector.body:                                      ; preds = %vector.body, %vector.ph
    %lsr.iv = phi ptr [ %scevgep, %vector.body ], [ @a, %vector.ph ]
    %vec.phi = phi <4 x i32> [ splat (i32 -2147483648), %vector.ph ], [ %3, %vector.body ]
    %vec.ind = phi <4 x i32> [ <i32 0, i32 1, i32 2, i32 3>, %vector.ph ], [ %vec.ind.next, %vector.body ]
    %1 = phi i64 [ %0, %vector.ph ], [ %4, %vector.body ]
    %wide.load = load <4 x double>, ptr %lsr.iv, align 32, !tbaa !6
    %2 = fcmp fast olt <4 x double> %wide.load, zeroinitializer
    %3 = select <4 x i1> %2, <4 x i32> %vec.ind, <4 x i32> %vec.phi
    %vec.ind.next = add <4 x i32> %vec.ind, splat (i32 4)
    %scevgep = getelementptr i8, ptr %lsr.iv, i64 32
    %4 = call i64 @llvm.loop.decrement.reg.i64(i64 %1, i64 1)
    %5 = icmp ne i64 %4, 0
    br i1 %5, label %vector.body, label %middle.block, !llvm.loop !10
  
  middle.block:                                     ; preds = %vector.body
    %inc7 = add nuw nsw i32 %nl.017, 1
    %exitcond19.not = icmp eq i32 %inc7, 100000
    br i1 %exitcond19.not, label %for.cond.cleanup, label %vector.ph, !llvm.loop !15
  
  for.cond.cleanup:                                 ; preds = %middle.block
    %6 = tail call i32 @llvm.vector.reduce.smax.v4i32(<4 x i32> %3)
    %rdx.select.cmp.not = icmp eq i32 %6, -2147483648
    %7 = add nsw i32 %6, 1
    %add = select i1 %rdx.select.cmp.not, i32 0, i32 %7
    %conv9 = sitofp i32 %add to double
    ret double %conv9
  }
  
  ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
  declare i32 @llvm.vector.reduce.smax.v4i32(<4 x i32>) #1
  
  ; Function Attrs: nocallback noduplicate nofree nosync nounwind willreturn
  declare i64 @llvm.start.loop.iterations.i64(i64) #2
  
  ; Function Attrs: nocallback noduplicate nofree nosync nounwind willreturn
  declare i64 @llvm.loop.decrement.reg.i64(i64, i64) #2
  
  attributes #0 = { nofree norecurse nosync nounwind memory(read, argmem: none, inaccessiblemem: none) uwtable vscale_range(4,4) "approx-func-fp-math"="true" "frame-pointer"="non-leaf" "no-infs-fp-math"="true" "no-nans-fp-math"="true" "no-signed-zeros-fp-math"="true" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="a64fx" "target-features"="+aes,+complxnum,+crc,+fp-armv8,+fullfp16,+lse,+neon,+outline-atomics,+perfmon,+ras,+rdm,+sha2,+sve,+v8.1a,+v8.2a,+v8a,-fmv" "unsafe-fp-math"="true" }
  attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
  attributes #2 = { nocallback noduplicate nofree nosync nounwind willreturn }
  
  !llvm.module.flags = !{!0, !1, !2, !3, !4}
  !llvm.ident = !{!5}
  
  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 8, !"PIC Level", i32 2}
  !2 = !{i32 7, !"PIE Level", i32 2}
  !3 = !{i32 7, !"uwtable", i32 2}
  !4 = !{i32 7, !"frame-pointer", i32 1}
  !5 = !{!"clang version 20.1.8"}
  !6 = !{!7, !7, i64 0}
  !7 = !{!"double", !8, i64 0}
  !8 = !{!"omnipotent char", !9, i64 0}
  !9 = !{!"Simple C/C++ TBAA"}
  !10 = distinct !{!10, !11, !12, !13, !14}
  !11 = !{!"llvm.loop.mustprogress"}
  !12 = !{!"llvm.loop.unroll.disable"}
  !13 = !{!"llvm.loop.isvectorized", i32 1}
  !14 = !{!"llvm.loop.unroll.runtime.disable"}
  !15 = distinct !{!15, !11, !12}

...
---
name:            target
alignment:       8
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHCatchret:   false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gpr32sp, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 2, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 3, class: fpr128, preferred-register: '', flags: [  ] }
  - { id: 4, class: fpr128, preferred-register: '', flags: [  ] }
  - { id: 5, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 6, class: fpr128, preferred-register: '', flags: [  ] }
  - { id: 7, class: fpr128, preferred-register: '', flags: [  ] }
  - { id: 8, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 9, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 10, class: gpr32all, preferred-register: '', flags: [  ] }
  - { id: 11, class: gpr32all, preferred-register: '', flags: [  ] }
  - { id: 12, class: gpr32all, preferred-register: '', flags: [  ] }
  - { id: 13, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 14, class: fpr128, preferred-register: '', flags: [  ] }
  - { id: 15, class: fpr128, preferred-register: '', flags: [  ] }
  - { id: 16, class: zpr, preferred-register: '', flags: [  ] }
  - { id: 17, class: gpr64common, preferred-register: '', flags: [  ] }
  - { id: 18, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 19, class: ppr_3b, preferred-register: '', flags: [  ] }
  - { id: 20, class: zpr, preferred-register: '', flags: [  ] }
  - { id: 21, class: ppr, preferred-register: '', flags: [  ] }
  - { id: 22, class: zpr, preferred-register: '', flags: [  ] }
  - { id: 23, class: zpr, preferred-register: '', flags: [  ] }
  - { id: 24, class: fpr128, preferred-register: '', flags: [  ] }
  - { id: 25, class: fpr128, preferred-register: '', flags: [  ] }
  - { id: 26, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 27, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 28, class: gpr32common, preferred-register: '', flags: [  ] }
  - { id: 29, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 30, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 31, class: fpr32, preferred-register: '', flags: [  ] }
  - { id: 32, class: fpr128, preferred-register: '', flags: [  ] }
  - { id: 33, class: fpr128, preferred-register: '', flags: [  ] }
  - { id: 34, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 35, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 36, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 37, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 38, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 39, class: fpr64, preferred-register: '', flags: [  ] }
liveins:         []
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
  savePoint:       ''
  restorePoint:    ''
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
  
    %12:gpr32all = COPY $wzr
    %11:gpr32all = COPY %12
    %16:zpr = INDEX_II_S 0, 1, implicit $vg
    %17:gpr64common = LOADgot target-flags(aarch64-got) @a
    %18:gpr32 = MOVi32imm 8000
    %19:ppr_3b = PTRUE_D 4, implicit $vg
    %25:fpr128 = MOVIv4i32 4, 0
    %29:gpr32 = MOVi32imm 100000
  
  bb.1.vector.ph:
    successors: %bb.2(0x80000000)
  
    %0:gpr32sp = PHI %11, %bb.0, %10, %bb.3
    %15:fpr128 = COPY %16.zsub
    %14:fpr128 = MOVIv4i32 128, 24
    %13:gpr64all = COPY %17
    %1:gpr64all = SUBREG_TO_REG 0, %18, %subreg.sub_32
  
  bb.2.vector.body:
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  
    %2:gpr64sp = PHI %13, %bb.1, %8, %bb.2
    %3:fpr128 = PHI %14, %bb.1, %6, %bb.2
    %4:fpr128 = PHI %15, %bb.1, %7, %bb.2
    %5:gpr64sp = PHI %1, %bb.1, %9, %bb.2
    %20:zpr = LD1D_IMM %19, %2, 0 :: (load (s256) from %ir.lsr.iv, !tbaa !6)
    %21:ppr = nofpexcept FCMLT_PPzZ0_D %19, killed %20
    %22:zpr = CPY_ZPzI_D killed %21, -1, 0
    %23:zpr = UZP1_ZZZ_S %22, %22
    %24:fpr128 = COPY %23.zsub
    %6:fpr128 = BSPv16i8 killed %24, %4, %3
    %7:fpr128 = ADDv4i32 %4, %25
    %26:gpr64sp = ADDXri %2, 32, 0
    %8:gpr64all = COPY %26
    %27:gpr64 = SUBSXri %5, 1, 0, implicit-def $nzcv
    %9:gpr64all = COPY %27
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.3
  
  bb.3.middle.block:
    successors: %bb.4(0x04000000), %bb.1(0x7c000000)
  
    %28:gpr32common = nuw nsw ADDWri %0, 1, 0
    %10:gpr32all = COPY %28
    dead $wzr = SUBSWrr %28, %29, implicit-def $nzcv
    Bcc 1, %bb.1, implicit $nzcv
    B %bb.4
  
  bb.4.for.cond.cleanup:
    %31:fpr32 = SMAXVv4i32v %6
    %33:fpr128 = IMPLICIT_DEF
    %32:fpr128 = INSERT_SUBREG %33, killed %31, %subreg.ssub
    %34:gpr32 = COPY %32.ssub
    %35:gpr32 = MOVi32imm -2147483648
    dead $wzr = SUBSWrr %34, killed %35, implicit-def $nzcv
    %37:gpr32 = COPY $wzr
    %38:gpr32 = CSINCWr %37, %34, 0, implicit $nzcv
    %39:fpr64 = nofpexcept SCVTFUWDri killed %38, implicit $fpcr
    $d0 = COPY %39
    RET_ReallyLR implicit $d0

...
